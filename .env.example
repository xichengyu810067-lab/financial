# 複製成 .env.local 後填入 Supabase 專案的值（Dashboard → Project Settings → API Keys）
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# （選填）E2E 與本機測試用的專用測試帳號；信箱網域必須是 .test，E2E 會拒絕其他帳號
# DEV_TEST_EMAIL=dev@yourname.test
# DEV_TEST_PASSWORD=
